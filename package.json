{
  "name": "jarvis-assistant",
  "version": "4.6.0",
  "description": "Application desktop Windows JARVIS Assistant en HTML, CSS et JavaScript vanilla avec Electron.",
  "main": "main.js",
  "private": true,
  "author": "lrdaax-ironman",
  "license": "MIT",
  "scripts": {
    "start": "\"%npm_node_execpath%\" ./node_modules/electron/cli.js .",
    "build": "\"%npm_node_execpath%\" ./scripts/build-windows.js",
    "test": "node --test tests/*.test.js",
    "test:bridge": "node --test tests/bridge-server.test.js",
    "test:memory": "node --test tests/memory-store.test.js",
    "test:mobile": "node --test tests/mobile-commands.test.js"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.lrdaaxironman.jarvisassistant",
    "productName": "JARVIS Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "voice.css",
      "script.js",
      "mobile.html",
      "mobile.css",
      "mobile.js",
      "mobile-command-routing.js",
      "mobile-import.js",
      "backup-manager.js",
      "bridge-server.js",
      "memory-store.js",
      "proactive-manager.js",
      "system-metrics.js",
      "main.js",
      "preload.js",
      "manifest.json",
      "service-worker.js",
      "vercel.json",
      "netlify.toml",
      "assets/icons/**/*",
      "voice/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS Assistant"
    }
  }
}
